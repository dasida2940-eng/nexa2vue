<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="MemberList" width="1280" height="720" titletext="회원 목록" onload="form_onload">
    <Layouts>
      <Layout height="720" width="1280">
        <Static id="sta_title" taborder="0" text="회원 &lt;목록&gt; {{x}}" left="20" top="10" width="300" height="30"/>
        <Div id="div_search" taborder="1" left="20" top="50" width="1240" height="50">
          <Layouts>
            <Layout>
              <Static id="sta_name" taborder="0" text="이름" left="10" top="10" width="60" height="28"/>
              <Edit id="edt_name" taborder="1" left="80" top="10" width="200" height="28"/>
              <Combo id="cbo_grade" taborder="2" left="300" top="10" width="150" height="28" innerdataset="ds_grade" codecolumn="CODE" datacolumn="NAME"/>
              <Button id="btn_search" taborder="3" text="조회" left="1120" top="10" width="100" height="28" onclick="btn_search_onclick"/>
            </Layout>
          </Layouts>
        </Div>
        <Grid id="grd_list" taborder="2" left="20" top="110" right="20" bottom="60" binddataset="ds_list" oncellclick="grd_list_oncellclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="120"/>
                <Column size="80"/>
                <Column size="200"/>
              </Columns>
              <Rows>
                <Row size="24" band="head"/>
                <Row size="24"/>
              </Rows>
              <Band id="head">
                <Cell text="이름"/>
                <Cell col="1" text="나이"/>
                <Cell col="2" text="이메일"/>
              </Band>
              <Band id="body">
                <Cell text="bind:NAME"/>
                <Cell col="1" text="bind:AGE"/>
                <Cell col="2" text="bind:EMAIL"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Button id="btn_add" taborder="3" text="추가" right="130" bottom="20" width="100" height="28" onclick="btn_add_onclick"/>
        <Button id="btn_save" taborder="4" text="저장" right="20" bottom="20" width="100" height="28" onclick="btn_save_onclick" enable="false"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="NAME" type="STRING" size="100"/>
          <Column id="GRADE" type="STRING" size="10"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_grade">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="10"/>
          <Column id="NAME" type="STRING" size="50"/>
        </ColumnInfo>
        <Rows>
          <Row><Col id="CODE">A</Col><Col id="NAME">정회원</Col></Row>
          <Row><Col id="CODE">B</Col><Col id="NAME">준회원</Col></Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_list">
        <ColumnInfo>
          <Column id="NAME" type="STRING" size="100"/>
          <Column id="AGE" type="INT" size="4"/>
          <Column id="EMAIL" type="STRING" size="200"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="div_search.form.edt_name" propid="value" datasetid="ds_search" columnid="NAME"/>
      <BindItem id="item1" compid="div_search.form.cbo_grade" propid="value" datasetid="ds_search" columnid="GRADE"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[include "lib::common.xjs";

this.fv_count = 0;

this.form_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
	this.gfn_initForm(obj);
	this.fn_search();
};

this.fn_search = function()
{
	this.transaction("selectMember", "svc::member/selectList.do", "input=ds_search", "ds_list=output", "mode=list", "fn_callback");
};

this.fn_callback = function(svcId, errCd, errMsg)
{
	if (errCd < 0) {
		this.alert(errMsg);
		return;
	}
	this.fv_count = this.ds_list.getRowCount();
	trace("count=" + this.fv_count);
	this.btn_save.set_enable(true);
};

this.btn_search_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	if (this.div_search.form.edt_name.value == "") {
		this.alert("이름을 입력하세요");
		this.div_search.form.edt_name.setFocus();
		return;
	}
	this.fn_search();
};

this.btn_add_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	var nRow = this.ds_list.addRow();
	this.ds_list.setColumn(nRow, "NAME", "신규");
	this.ds_list.rowposition = nRow;
};

this.btn_save_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
	if (!this.confirm("저장하시겠습니까?")) return;
	this.ds_list.filter("AGE > 20");
	this.parent.close();
};

this.grd_list_oncellclick = function(obj:nexacro.Grid, e:nexacro.GridClickEventInfo)
{
	var sName = this.ds_list.getColumn(e.row, "NAME");
	this.sta_title.set_text(sName);
};
]]></Script>
  </Form>
</FDL>
