  "description": "Local web tool that converts Nexacro (.xfdl/.xjs) sources to Vue 3 + Element Plus without sending source anywhere",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "nexa2vue": "bin/nexa2vue.js",
